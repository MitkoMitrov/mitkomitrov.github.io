{
  "name": "mitko-mk-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "predev": "node scripts/prepare-public.mjs",
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "node scripts/prepare-public.mjs",
    "build": "astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "yaml": "2.9.1"
  }
}

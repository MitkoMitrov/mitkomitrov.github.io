---
import analyticsScript from '../scripts/analytics.js?raw';
---
{import.meta.env.PROD && <>
  <button class="analytics-preferences" type="button" data-analytics-preferences hidden>Analytics preferences</button>
  <section class="analytics-panel" data-analytics-panel aria-labelledby="analytics-title" hidden>
    <h2 id="analytics-title">Analytics preferences</h2>
    <p>This site uses Google Analytics cookies automatically to measure visits. Choose Decline to stop future tracking. Data already sent is not automatically deleted. <a href="https://policies.google.com/privacy">Google’s privacy policy</a>.</p>
    <p class="analytics-status" data-analytics-status></p>
    <div class="analytics-actions">
      <button type="button" data-analytics-accept>Keep analytics on</button>
      <button type="button" data-analytics-decline>Decline</button>
    </div>
  </section>
  <script is:inline data-analytics-bootstrap set:html={analyticsScript} />
</>}
<style>
  button {font: inherit; color: var(--text); cursor: pointer;}
  button:focus-visible {outline: 2px solid var(--accent); outline-offset: 4px;}
  .analytics-preferences {padding: 0; border: 0; background: transparent; color: var(--muted); font-size: .8rem; text-decoration: underline; text-underline-offset: 3px;}
  .analytics-panel {flex: 0 0 100%; box-sizing: border-box; margin-top: 8px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--background); color: var(--text); text-align: left;}
  .analytics-panel[hidden], .analytics-preferences[hidden] {display: none;}
  h2 {margin: 0 0 8px; font-size: 1rem;}
  p {margin: 0 0 12px; font-size: .85rem; line-height: 1.55;}
  a {color: inherit; text-decoration: underline;}
  .analytics-status {color: var(--muted); font-size: .8rem;}
  .analytics-actions {display: flex; flex-wrap: wrap; gap: 10px;}
  .analytics-actions button {min-height: 44px; padding: 8px 20px; border: 1px solid var(--text); border-radius: 8px; background: transparent;}
</style>

---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
	titleId?: string;
}

// Adapted from withastro/astro/examples/portfolio (MIT); see third_party/.
const { align = 'center', tagline, title, titleId } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		<h1 class="title" id={titleId}>{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}

	.title,
	.tagline {
		max-width: 40ch;
		margin-inline: auto;
	}

	.title {
		font-size: clamp(2.25rem, 5vw, 3.25rem);
		color: var(--gray-0);
	}

	.tagline {font-size: 1.1rem; color: var(--text);}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .title,
		.start .tagline {
			margin-inline: unset;
		}

	}
</style>

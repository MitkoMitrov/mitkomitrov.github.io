---
import {loadArticles} from '../../lib/content.mjs';
const articles = await loadArticles();
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><title>WEB-01 prototype</title><meta name="robots" content="noindex"/></head><body><h1>WEB-01 prototype</h1><ul>{articles.map(article => <li><a href={`${import.meta.env.BASE_URL}articles/${article.slug.current}/`}>{article.title}</a></li>)}</ul>{articles.length === 0 && <p>No published articles.</p>}<p>Isolated static rendering test. This is separate from mitko.mk.</p></body></html>
